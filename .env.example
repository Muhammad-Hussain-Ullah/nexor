# Environment variables for Nexor
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required for the contact/demo-request form) ---
# Find these in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Public site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: contact form / lead notification email ---
CONTACT_NOTIFICATION_EMAIL=dispatch@nexorvoice.com

# Add any CRM / calendar integration keys below as needed
# JOBBER_API_KEY=
# SERVICETITAN_API_KEY=
# GHL_API_KEY=
